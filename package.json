{
  "name": "pear.js",
  "version": "0.0.0",
  "private": true,
  "description": "PEAR's robot station in TypeScript: drive an SO-101 arm from a browser with a PEAR model server. Unofficial port of mit-han-lab/pear.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
